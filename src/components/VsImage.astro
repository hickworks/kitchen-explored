---
interface Side {
  src: string;
  label: string;
  alt?: string;
}

interface Props {
  left: Side;
  right: Side;
  compact?: boolean;
}

const { left, right, compact = false } = Astro.props;
---

{compact ? (
  <div class="relative w-full h-full flex">
    <div class="w-1/2 h-full overflow-hidden">
      <img
        src={left.src}
        alt={left.alt ?? left.label}
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
        loading="lazy"
      />
    </div>
    <div class="w-1/2 h-full overflow-hidden">
      <img
        src={right.src}
        alt={right.alt ?? right.label}
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
        loading="lazy"
      />
    </div>
    <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-white/80"></div>
    <span
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[10px] font-bold uppercase tracking-wider text-white px-2 py-1 rounded-full shadow-sm"
      style="background:linear-gradient(135deg,#f78745,#f85026)"
    >
      vs
    </span>
  </div>
) : (
  <div class="w-full rounded-xl border border-gray-100 bg-gray-50 p-6 sm:p-10">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-6 sm:gap-10">
      <div class="text-center">
        <div class="aspect-square rounded-lg overflow-hidden bg-white">
          <img
            src={left.src}
            alt={left.alt ?? left.label}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="mt-4 text-base font-semibold text-navy">{left.label}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <div class="w-px h-16 sm:h-20 bg-gray-200"></div>
        <span
          class="shrink-0 text-[11px] font-bold uppercase tracking-wider text-white px-2.5 py-1 rounded-full"
          style="background:linear-gradient(135deg,#f78745,#f85026)"
        >
          vs
        </span>
        <div class="w-px h-16 sm:h-20 bg-gray-200"></div>
      </div>
      <div class="text-center">
        <div class="aspect-square rounded-lg overflow-hidden bg-white">
          <img
            src={right.src}
            alt={right.alt ?? right.label}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="mt-4 text-base font-semibold text-navy">{right.label}</p>
      </div>
    </div>
  </div>
)}
